# Fitness App - Environment Configuration Example
# Copy this file to .env and fill in your actual values

##########################################################
# Application Configuration
##########################################################
# Application mode: development, testing, production
APP_MODE=development

##########################################################
# Server Configuration
##########################################################
HOST=0.0.0.0
PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_IDLE_TIMEOUT=60s

##########################################################
# Database Configuration
##########################################################
# Options: supabase, memory
DATABASE_MODE=memory

# Supabase Configuration (when DATABASE_MODE=supabase)
# Get your credentials from: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_STORAGE_BUCKET=lumen-nutrition

# Database Connection Pool
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=5
DATABASE_CONN_MAX_LIFETIME=5m

# PostgreSQL connection string (alternative to Supabase)
DATABASE_URL=


##########################################################
# Storage Configuration
##########################################################
# Supabase storage bucket name for nutrition photos
STORAGE_BUCKET_NAME=lumen-nutrition

# Maximum photo size in megabytes (1-100)
STORAGE_MAX_PHOTO_SIZE_MB=10

# Allowed photo formats (comma-separated)
STORAGE_ALLOWED_PHOTO_FORMATS=jpg,jpeg,png,heic

##########################################################
# Cache Configuration
##########################################################
# Options: memory, redis, disabled
CACHE_MODE=memory

# Redis Configuration (when CACHE_MODE=redis)
# Format: redis://[username:password@]host:port[/database]
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Cache time-to-live (TTL) duration
# Supported units: s (seconds), m (minutes), h (hours)
CACHE_DEFAULT_TTL=5m

##########################################################
# AI Service Configuration
##########################################################

# Groq API Configuration
# Get your API key from: https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile
GROQ_MAX_REQUESTS_PER_DAY=100

# OpenRouter API Configuration
# Get your API key from: https://openrouter.ai/
OPENROUTER_API_KEY=
OPENROUTER_NUTRITION_PRESET=anthropic/claude-3.5-sonnet
OPENROUTER_VISION_PRESET=anthropic/claude-3.5-sonnet

##########################################################
# Logging Configuration
##########################################################
# Options: debug, info, warn, error
LOG_LEVEL=info

# Options: json, console
LOG_FORMAT=console

# Options: stdout, stderr, file
LOG_OUTPUT=stdout

LOG_FILE_PATH=logs/app.log

##########################################################
# Feature Flags
##########################################################
# Enable/disable authentication and authorization
FEATURE_AUTH=false

# Enable/disable file storage (Supabase storage)
FEATURE_STORAGE=false

# Enable/disable AI nutrition analysis
FEATURE_AI_ANALYSIS=true

# Enable/disable notifications
FEATURE_NOTIFICATIONS=false

# Enable/disable real-time updates
FEATURE_REALTIME=false

# Enable/disable metrics collection
FEATURE_METRICS=true

# Enable/disable API rate limiting
FEATURE_RATE_LIMIT=false

# Enable/disable response caching
FEATURE_CACHE=true

##########################################################
# Rate Limiting Configuration
##########################################################
# Maximum AI parsing requests per user per day
RATE_LIMIT_AI_PARSE_PER_DAY=50

# Maximum API calls per user per hour
RATE_LIMIT_API_CALLS_PER_HOUR=1000

# Cost limit per user per month (USD)
RATE_LIMIT_COST_PER_USER_PER_MONTH=10.0

# Global cost limit per month (USD)
RATE_LIMIT_GLOBAL_COST_PER_MONTH=1000.0

##########################################################
# CORS Configuration
##########################################################
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization

